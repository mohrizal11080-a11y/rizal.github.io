<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toyota Indonesia | Discover Freedom</title>
    <link rel="stylesheet" href="style.css">
    <!-- Google Fonts & Font Awesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="#" class="brand-logo">
                <span class="toyota-red">TOYOTA</span>
            </a>
            
            <ul class="nav-links">
                <li><a href="#hero">Beranda</a></li>
                <li><a href="#models">Model</a></li>
                <li><a href="#features">Keunggulan</a></li>
                <li><a href="#test-drive">Test Drive</a></li>
            </ul>

            <a href="#test-drive" class="btn-primary">Pesan Sekarang</a>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section id="hero" class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="badge-red">GR SPORT SERIES</span>
            <h1>Langkah Baru Menuju Masa Depan Motorization</h1>
            <p>Nikmati performa tinggi, efisiensi bahan bakar maksimal, dan kenyamanan tanpa kompromi dengan inovasi Hybrid Electric Vehicle dari Toyota.</p>
            <div class="hero-actions">
                <a href="#models" class="btn-primary">Jelajahi Model</a>
                <a href="#test-drive" class="btn-secondary"><i class="fa-solid fa-steering-wheel"></i> Booking Test Drive</a>
            </div>
        </div>
    </section>

    <!-- HIGHLIGHT STATS -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <h3>100+</h3>
                <p>Jaringan Dealer Resmi</p>
            </div>
            <div class="stat-card">
                <h3>5 Thn</h3>
                <p>Garansi Baterai Hybrid</p>
            </div>
            <div class="stat-card">
                <h3>T-Connect</h3>
                <p>Konektivitas Pintar 24/7</p>
            </div>
            <div class="stat-card">
                <h3>5-Star</h3>
                <p>Keamanan ASEAN NCAP</p>
            </div>
        </div>
    </section>

    <!-- FEATURED MODELS -->
    <section id="models" class="models-section">
        <div class="section-title">
            <h2>Model Unggulan</h2>
            <p>Pilih kendaraan yang sesuai dengan gaya hidup dan kebutuhan Anda</p>
        </div>

        <div class="card-grid">
            <!-- Card 1 -->
            <div class="model-card">
                <div class="card-img-wrapper">
                    <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=800&q=80" alt="Toyota GR Supra">
                    <span class="card-tag">Performance</span>
                </div>
                <div class="card-body">
                    <h3>GR Supra</h3>
                    <p class="price">Mulai dari Rp 2.188.000.000</p>
                    <ul class="card-specs">
                        <li><i class="fa-solid fa-gauge-high"></i> 3.0L Inline-6 Turbo</li>
                        <li><i class="fa-solid fa-bolt"></i> 387 PS / 500 Nm</li>
                    </ul>
                    <a href="#test-drive" class="btn-outline">Detail Spesifikasi</a>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="model-card">
                <div class="card-img-wrapper">
                    <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=800&q=80" alt="Toyota Fortuner">
                    <span class="card-tag">SUV</span>
                </div>
                <div class="card-body">
                    <h3>Fortuner GR Sport</h3>
                    <p class="price">Mulai dari Rp 610.000.000</p>
                    <ul class="card-specs">
                        <li><i class="fa-solid fa-gears"></i> 2.8L Diesel Turbo</li>
                        <li><i class="fa-solid fa-shield-halved"></i> Toyota Safety Sense</li>
                    </ul>
                    <a href="#test-drive" class="btn-outline">Detail Spesifikasi</a>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="model-card">
                <div class="card-img-wrapper">
                    <img src="https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=800&q=80" alt="Toyota Camry Hybrid">
                    <span class="card-tag">Hybrid</span>
                </div>
                <div class="card-body">
                    <h3>Camry Hybrid</h3>
                    <p class="price">Mulai dari Rp 937.000.000</p>
                    <ul class="card-specs">
                        <li><i class="fa-solid fa-leaf"></i> 2.5L HEV Engine</li>
                        <li><i class="fa-solid fa-couch"></i> Executive Rear Seat</li>
                    </ul>
                    <a href="#test-drive" class="btn-outline">Detail Spesifikasi</a>
                </div>
            </div>
        </div>
    </section>

    <!-- TEST DRIVE FORM SECTION -->
    <section id="test-drive" class="testdrive-section">
        <div class="form-wrapper">
            <div class="form-header">
                <h2>Rasakan Pengalaman Berkendara</h2>
                <p>Jadwalkan uji coba kendaraan Toyota pilihan Anda di dealer terdekat.</p>
            </div>
            
            <form class="testdrive-form" action="#" method="POST">
                <div class="form-group">
                    <label for="name">Nama Lengkap</label>
                    <input type="text" id="name" placeholder="Masukkan nama Anda" required>
                </div>

                <div class="form-group">
                    <label for="phone">Nomor Telepon (WhatsApp)</label>
                    <input type="tel" id="phone" placeholder="0812xxxxxxx" required>
                </div>

                <div class="form-group">
                    <label for="model">Pilih Model Kendaraan</label>
                    <select id="model" required>
                        <option value="">-- Pilih Mobil --</option>
                        <option value="supra">GR Supra</option>
                        <option value="fortuner">Fortuner GR Sport</option>
                        <option value="camry">Camry Hybrid</option>
                        <option value="innovazenix">Kijang Innova Zenix</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="city">Kota Domisili</label>
                    <input type="text" id="city" placeholder="Contoh: Jakarta Selatan" required>
                </div>

                <button type="submit" class="btn-primary btn-full">Kirim Permintaan Test Drive</button>
            </form>
        </div>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="footer-container">
            <div class="footer-brand">
                <h3>TOYOTA</h3>
                <p>Let's Go Beyond. Menghadirkan inovasi dan solusi mobilitas terbaik untuk masyarakat Indonesia.</p>
            </div>
            <div class="footer-links">
                <h4>Navigasi</h4>
                <ul>
                    <li><a href="#hero">Beranda</a></li>
                    <li><a href="#models">Model Mobil</a></li>
                    <li><a href="#test-drive">Test Drive</a></li>
                </ul>
            </div>
            <div class="footer-socials">
                <h4>Ikuti Kami</h4>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    <a href="#"><i class="fa-brands fa-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Toyota Motor Indonesia. All Rights Reserved.</p>
        </div>
    </footer>

</body>
</html>
